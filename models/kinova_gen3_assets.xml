<mujocoinclude>

    <default>

        <default class="visual">
            <geom
                type="mesh"
                contype="0"
                conaffinity="0"
                group="2"
                rgba="0.75294 0.75294 0.75294 1"/>
        </default>

        <default class="collision">
            <geom
                type="mesh"
                group="3"/>
        </default>

        <!-- Gen3 R07, table 44: robot torque soft limits, Nm. -->
        <default class="large_actuator">
            <position
                kp="2000"
                kv="100"
                forcerange="-39 39"/>
        </default>

        <default class="small_actuator">
            <position
                kp="500"
                kv="50"
                forcerange="-9 9"/>
        </default>

        <site
            size="0.001"
            rgba="0.5 0.5 0.5 0.3"
            group="4"/>

    </default>

    <asset>

        <mesh name="base_link_mesh" file="base_link.STL"/>
        <mesh name="shoulder_link_mesh" file="shoulder_link.STL"/>
        <mesh name="half_arm_1_link_mesh" file="half_arm_1_link.STL"/>
        <mesh name="half_arm_2_link_mesh" file="half_arm_2_link.STL"/>
        <mesh name="forearm_link_mesh" file="forearm_link.STL"/>
        <mesh name="spherical_wrist_1_link_mesh" file="spherical_wrist_1_link.STL"/>
        <mesh name="spherical_wrist_2_link_mesh" file="spherical_wrist_2_link.STL"/>
        <mesh name="bracelet_with_vision_link_mesh" file="bracelet_with_vision_link.STL"/>

    </asset>

</mujocoinclude>
